) lines.push(`| ${c} | ${n} |`);\n\treturn lines.join(\"\\n\") + \"\\n\";\n}\n\nif (import.meta.url === `file://${process.argv[1]}`) {\n\tconst report = buildReport(loadCatalog(\"data/books.csv\"), readFileSync(\"logs/app.log\", \"utf8\"));\n\twriteFileSync(\"data/report.md\", report);\n}\nE\ncat > scripts/lowstock.js <<'E'\nimport { readFileSync } from \"node:fs\";\nimport { loadCatalog } from \"../src/csv.js\";\n\nexport function lowStock(books, threshold) {\n\treturn books.filter((b) => b.quantity < threshold).map((b) => b.sku).sort();\n}\n\nif (import.meta.url === `file://${process.argv[1]}`) {\n\tconst { lowStockThreshold } = JSON.parse(readFileSync(\"config/settings.json\", \"utf8\"));\n\tfor (const sku of lowStock(loadCatalog(\"data/books.csv\"), lowStockThreshold)) console.log(sku);\n}\nE\ncat > test/csv.test.js <<'E'\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { parseCsv } from \"../src/csv.js\";\n\ntest(\"parseCsv quoted commas and numbers\", () => {\n\tconst [row] = parseCsv('sku,title,priceCents,quantity\\nA1,\"Uomini, boschi\",1643,9\\n');\n\tassert.deepEqual(row, { sku: \"A1\", title: \"Uomini, boschi\", priceCents: 1643, quantity: 9 });\n});\nE\ncat >> test/format.test.js <<'E'\n\ntest(\"slugify strips accents\", () => {\n\tassert.equal(slugify(\"Perché è così\"), \"perche-e-cosi\");\n});\nE\ncat > test/pagination.test.js <<'E'\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { paginate, pageCount } from \"../src/pagination.js\";\n\ntest(\"paginate page 1 returns first items\", () => {\n\tassert.deepEqual(paginate([1, 2, 3, 4, 5], 1, 2), [1, 2]);\n\tassert.deepEqual(paginate([1, 2, 3, 4, 5], 3, 2), [5]);\n\tassert.equal(pageCount([1, 2, 3, 4, 5], 2), 3);\n});\nE\ncat > test/search.test.js <<'E'\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { searchBooks } from \"../src/search.js\";\n\nconst books = [\n\t{ sku: \"1\", title: \"Perché no\", author: \"A\", genre: \"g\", priceCents: 300 },\n\t{ sku: \"2\", title: \"Altro\", author: \"B\", genre: \"g\", priceCents: 100 },\n\t{ sku: \"3\", title: \"PERCHE sì\", author: \"A\", genre: \"h\", priceCents: 200 },\n];\n\ntest(\"text ignores case and accents\", () => {\n\tassert.equal(searchBooks(books, { text: \"perché\" }).total, 2);\n});\ntest(\"filters, sort and pagination\", () => {\n\tassert.deepEqual(searchBooks(books, { sortBy: \"price\" }).items.map((b) => b.sku), [\"2\", \"3\", \"1\"]);\n\tassert.deepEqual(searchBooks(books, { sortBy: \"title\" }).items.map((b) => b.sku), [\"2\", \"1\", \"3\"]);\n\tassert.equal(searchBooks(books, { genre: \"g\", author: \"A\" }).total, 1);\n\tconst r = searchBooks(books, { size: 2, page: 2 });\n\tassert.deepEqual([r.items.length, r.total, r.pages], [1, 3, 2]);\n});\nE\ncat > test/scripts.test.js <<'E'\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { buildReport } from \"../scripts/report.js\";\nimport { lowStock } from \"../scripts/lowstock.js\";\n\ntest(\"buildReport\", () => {\n\tconst books = [\n\t\t{ genre: \"x\", quantity: 2 },\n\t\t{ genre: \"x\", quantity: 3 },\n\t];\n\tconst log = \"t ERROR [E1] a\\nt ERROR [E1] b\\nt ERROR [E2] c\\nt INFO ok\\nt ERROR [E3] d\\nt ERROR [E4] e\\nt ERROR [E4] f\\nt ERROR [E4] g\";\n\tconst out = buildReport(books, log);\n\tassert.match(out, /\\| x \\| 2 \\| 5 \\|/);\n\tassert.match(out, /\\| E4 \\| 3 \\|\\n\\| E1 \\| 2 \\|\\n\\| E2 \\| 1 \\|\\n/);\n\tassert.doesNotMatch(out, /E3/);\n});\n\ntest(\"lowStock sorted and strict\", () => {\n\tconst books = [{ sku: \"B\", quantity: 1 }, { sku: \"A\", quantity: 0 }, { sku: \"C\", quantity: 3 }];\n\tassert.deepEqual(lowStock(books, 3), [\"A\", \"B\"]);\n});\nE\nnode scripts/report.js && node scripts/lowstock.js | head -3; cat data/report.md; npm test 2>&1 | tail -12"}
