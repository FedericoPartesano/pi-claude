2026-10-07T07:15:23.561Z unmatched MCP call bash {"command":"cat > src/search.js <<'E'\nconst norm = (s) =>\n\tString(s ?? \"\")\n\t\t.normalize(\"NFD\")\n\t\t.replace(/[̀-ͯ]/g, \"\")\n\t\t.toLowerCase();\n\nexport function searchBooks(books, { text, genre, author, sortBy, page = 1, size = 20 } = {}) {\n\tlet items = books.filter((book) => {\n\t\tif (text && !norm(book.title).includes(norm(text))) return false;\n\t\tif (genre && book.genre !== genre) return false;\n\t\tif (author && book.author !== author) return false;\n\t\treturn true;\n\t});\n\tif (sortBy === \"price\") items.sort((a, b) => a.priceCents - b.priceCents);\n\telse if (sortBy === \"title\") items.sort((a, b) => a.title.localeCompare(b.title));\n\tconst total = items.length;\n\tconst start = (page - 1) * size;\n\treturn { items: items.slice(start, start + size), total, pages: Math.ceil(total / size) };\n}\nE\ncat > test/search.test.js <<'E'\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { searchBooks } from \"../src/search.js\";\n\nconst books = [\n\t{ title: \"Il Nome della Rosa\", author: \"Eco\", genre: \"giallo\", priceCents: 1500 },\n\t{ title: \"Àncora\", author: \"X\", genre: \"saggio\", priceCents: 500 },\n\t{ title: \"Baudolino\", author: \"Eco\", genre: \"storico\", priceCents: 1000 },\n];\n\ntest(\"text ignores case and accents\", () => {\n\tassert.equal(searchBooks(books, { text: \"ancora\" }).total, 1);\n\tassert.equal(searchBooks(books, { text: \"ROSA\" }).items[0].author, \"Eco\");\n});\n\ntest(\"filters genre and author\", () => {\n\tassert.equal(searchBooks(books, { author: \"Eco\" }).total, 2);\n\tassert.equal(searchBooks(books, { author: \"Eco\", genre: \"storico\" }).total, 1);\n});\n\ntest(\"sorting without mutating input\", () => {\n\tconst copy = [...books];\n\tassert.deepEqual(searchBooks(books, { sortBy: \"price\" }).items.map((b) => b.priceCents), [500, 1000, 1500]);\n\tassert.equal(searchBooks(books, { sortBy: \"title\" }).items[0].title, \"Àncora\");\n\tassert.deepEqual(books, copy);\n});\n\ntest(\"pagination\", () => {\n\tconst r = searchBooks(books, { size: 2, page: 2, sortBy: \"price\" });\n\tassert.equal(r.total, 3);\n\tassert.equal(r.pages, 2);\n\tassert.equal(r.items.length, 1);\n\tassert.equal(searchBooks(books, {}).pages, 1);\n});\nE\nnode --test test/search.test.js 2>&1 | tail -8"}
