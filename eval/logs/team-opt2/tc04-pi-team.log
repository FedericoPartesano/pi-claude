2026-10-07T07:03:05.494Z unmatched MCP call bash {"command":"cat > scripts/report.js <<'EOF'\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { fileURLToPath } from 'node:url';\nimport path from 'node:path';\n\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\n\nfunction parseCsv(text) {\n  const rows = [];\n  let row = [], field = '', q = false;\n  for (let i = 0; i < text.length; i++) {\n    const c = text[i];\n    if (q) {\n      if (c === '\"') {\n        if (text[i + 1] === '\"') { field += '\"'; i++; } else q = false;\n      } else field += c;\n    } else if (c === '\"') q = true;\n    else if (c === ',') { row.push(field); field = ''; }\n    else if (c === '\\n' || c === '\\r') {\n      if (c === '\\r' && text[i + 1] === '\\n') i++;\n      row.push(field); field = '';\n      if (row.some((f) => f !== '')) rows.push(row);\n      row = [];\n    } else field += c;\n  }\n  row.push(field);\n  if (row.some((f) => f !== '')) rows.push(row);\n  return rows;\n}\n\nconst [header, ...rows] = parseCsv(readFileSync(path.join(root, 'data/books.csv'), 'utf8').replace(/^﻿/, ''));\nconst gi = header.indexOf('genre'), qi = header.indexOf('quantity');\nconst genres = new Map();\nfor (const r of rows) {\n  const g = r[gi];\n  const e = genres.get(g) ?? { n: 0, q: 0 };\n  e.n++;\n  e.q += Number(r[qi]) || 0;\n  genres.set(g, e);\n}\n\nconst codes = new Map();\nfor (const line of readFileSync(path.join(root, 'logs/app.log'), 'utf8').split(/\\r?\\n/)) {\n  if (!/\\bERROR\\b/.test(line)) continue;\n  const m = line.match(/\\[(E\\d+)\\]/);\n  if (m) codes.set(m[1], (codes.get(m[1]) ?? 0) + 1);\n}\nconst top = [...codes].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 3);\n\nconst md = [\n  '# Report', '',\n  '## Libri per genere', '',\n  '| Genere | Libri | Quantità totale |', '|---|---|---|',\n  ...[...genres].sort((a, b) => a[0].localeCompare(b[0])).map(([g, v]) => `| ${g} | ${v.n} | ${v.q} |`),\n  '', '## Top 3 codici errore', '',\n  '| Codice | Conteggio |', '|---|---|',\n  ...top.map(([c, n]) => `| ${c} | ${n} |`), '',\n].join('\\n');\nwriteFileSync(path.join(root, 'data/report.md'), md);\nEOF\nnode scripts/report.js && cat data/report.md\necho ---; awk -F, 'NR>1{n[$4]++;q[$4]+=$NF}END{for(g in n)print g,n[g],q[g]}' data/books.csv | sort\ngrep ERROR logs/app.log | grep -o '\\[E[0-9]*\\]' | sort | uniq -c | sort -rn | head -4; grep -c '\"' data/books.csv"}
