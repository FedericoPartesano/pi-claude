tif (field !== \"\" || row.length) {\n\t\trow.push(field);\n\t\trecords.push(row);\n\t}\n\tconst [columns, ...rows] = records.filter((r) => !(r.length === 1 && r[0] === \"\"));\n\treturn rows.map((values) => Object.fromEntries(columns.map((column, index) => [column, values[index]])));\n}\n\n'''\nopen(p,'w').write(s[:a]+new+s[b:])\nE\ncat >> test/format.test.js <<'E'\n\ntest(\"formatPrice negative\", () => {\n\tassert.equal(formatPrice(-150), \"€ -1,50\");\n});\n\ntest(\"slugify accents\", () => {\n\tassert.equal(slugify(\"Perché è così\"), \"perche-e-cosi\");\n});\nE\ncat > test/pagination.test.js <<'E'\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { paginate } from \"../src/pagination.js\";\n\ntest(\"paginate page 1 returns first items\", () => {\n\tassert.deepEqual(paginate([1, 2, 3, 4, 5], 1, 2), [1, 2]);\n\tassert.deepEqual(paginate([1, 2, 3, 4, 5], 3, 2), [5]);\n});\nE\ncat > test/csv.test.js <<'E'\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { parseCsv, loadCatalog } from \"../src/csv.js\";\n\ntest(\"parseCsv quoted commas\", () => {\n\tconst [row] = parseCsv('a,b,c\\n1,\"x, y\",3\\n');\n\tassert.deepEqual(row, { a: \"1\", b: \"x, y\", c: \"3\" });\n});\n\ntest(\"loadCatalog BK0057\", () => {\n\tconst book = loadCatalog(\"data/books.csv\").find((b) => b.sku === \"BK0057\" || b.id === \"BK0057\");\n\tassert.equal(book.title, \"Uomini, boschi e api\");\n\tassert.equal(book.author, \"Levi\");\n});\nE\nnpm test 2>&1 | tail -25"}
