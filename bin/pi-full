#!/usr/bin/env bash
# Pi con le estensioni "pesanti": web, todo, domande, subagent, team.
# I loro tool partono spenti (extensions/tool-groups.ts): il modello li accende con load_tools quando servono,
# l'utente con /tools. PI_FULL_TOOLS=web,team li precarica, PI_FULL_TOOLS=all li tiene tutti accesi.
# Il `pi` normale resta minimale (4 tool base + hook di sicurezza a costo zero).
# `pi-full --pick ...` fa prima scegliere il progetto (recenti o navigazione) e avvia Pi in quella cartella.
REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
A="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
EXTENSIONS=(
  "$A/npm/node_modules/pi-web-access"
  "$A/npm/node_modules/@juicesharp/rpiv-todo"
  "$A/npm/node_modules/@juicesharp/rpiv-ask-user-question"
  "$A/optional-extensions/subagent"
  "$REPO/pi-team"
  "$REPO/extensions/tool-groups.ts" # per ultima: gestisce i tool delle estensioni precedenti
)

if [ "${1:-}" = "--pick" ]; then
  shift
  chosen="$(mktemp)"
  node --disable-warning=ExperimentalWarning "$REPO/pi-picker/bin/pick-project.ts" --out "$chosen" || { rm -f "$chosen"; exit 1; }
  cd "$(cat "$chosen")" || exit 1
  rm -f "$chosen"
fi

args=()
for ext in "${EXTENSIONS[@]}"; do
  [ -e "$ext" ] || { echo "pi-full: manca $ext — rilancia $REPO/install.sh" >&2; exit 1; }
  args+=(-e "$ext")
done
# /custom-reload (pi-ui): Pi writes the session to reopen and quits; start it again with the same extensions.
RESTART="${PI_UI_RESTART_FILE:-$A/pi-ui-restart}"
rm -f "$RESTART"
# Intro animation (pi-ui): only on the first start, not after /custom-reload. PI_UI_INTRO=0 turns it off.
# Full intro once a day (the first start); later starts go straight in. PI_UI_INTRO=always shows it every time.
INTRO_STAMP="$A/pi-ui-intro-day"
if [ "${PI_UI_INTRO:-1}" = always ] || [ "$(cat "$INTRO_STAMP" 2>/dev/null)" != "$(date +%F)" ]; then show_intro=1; else show_intro=0; fi
if [ -t 1 ] && [ "$show_intro" = 1 ] && [ "${PI_UI_INTRO:-1}" != 0 ] && [ "${PI_UI:-}" != off ]; then
  date +%F > "$INTRO_STAMP" 2>/dev/null
  branch="$(git branch --show-current 2>/dev/null)"
  node --disable-warning=ExperimentalWarning "$REPO/pi-ui/bin/intro.ts" "claude code · pi-full · $(basename "$PWD")${branch:+ ⎇ $branch}" || true
fi
# Startup: Pi checks npm package updates by running `npm view` in the project folder; in a big monorepo npm loads its
# whole dependency tree (measured: ~20 s of CPU at every start, slowing typing). PI_OFFLINE=0 keeps the checks;
# `pi update` updates by hand.
export PI_OFFLINE="${PI_OFFLINE:-1}"
[ "$PI_OFFLINE" = 0 ] && unset PI_OFFLINE
PI_UI_LOOP=1 pi "${args[@]}" "$@"
code=$?
while [ -f "$RESTART" ]; do
  session="$(sed -n 's/^session=//p' "$RESTART")"
  dir="$(sed -n 's/^cwd=//p' "$RESTART")"
  rm -f "$RESTART"
  [ -n "$dir" ] && cd "$dir"
  if [ -n "$session" ]; then PI_UI_LOOP=1 pi "${args[@]}" --session "$session"; else PI_UI_LOOP=1 pi "${args[@]}"; fi
  code=$?
done
exit $code
