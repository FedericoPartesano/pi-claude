).write(s)\np='config/settings.json';s=open(p).read()\ns=s.replace('Threshhold','Threshold');open(p,'w').write(s)\nE\ncat > src/search.js <<'E'\nimport { paginate, pageCount } from \"./pagination.js\";\n\nconst fold = (text) =>\n\tString(text).normalize(\"NFD\").replace(/[̀-ͯ]/g, \"\").toLowerCase();\n\nexport function searchBooks(books, { text, genre, author, sortBy, page = 1, size = 20 } = {}) {\n\tlet results = books.filter((book) => {\n\t\tif (text && !fold(book.title).includes(fold(text))) return false;\n\t\tif (genre && book.genre !== genre) return false;\n\t\tif (author && book.author !== author) return false;\n\t\treturn true;\n\t});\n\tif (sortBy === \"price\") results = [...results].sort((a, b) => a.priceCents - b.priceCents);\n\telse if (sortBy === \"title\") results = [...results].sort((a, b) => a.title.localeCompare(b.title));\n\treturn { items: paginate(results, page, size), total: results.length, pages: pageCount(results, size) };\n}\nE\ncat > scripts/report.js <<'E'\nimport { readFileSync, writeFileSync } from \"node:fs\";\nimport { loadCatalog } from \"../src/csv.js\";\n\nexport function buildReport(books, logText) {\n\tconst genres = new Map();\n\tfor (const b of books) {\n\t\tconst g = genres.get(b.genre) ?? { count: 0, quantity: 0 };\n\t\tg.count++;\n\t\tg.quantity += b.quantity;\n\t\tgenres.set(b.genre, g);\n\t}\n\tconst errors = new Map();\n\tfor (const m of logText.matchAll(/\\bERROR \\[(\\w+)\\]/g)) errors.set(m[1], (errors.get(m[1]) ?? 0) + 1);\n\tconst top = [...errors].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 3);\n\tconst lines = [\"# Report\", \"\", \"## Libri per genere\", \"\", \"| Genere | Libri | Quantità totale |\", \"|---|---|---|\"];\n\tfor (const [g, v] of [...genres].sort((a, b) => a[0].localeCompare(b[0]))) {\n\t\tlines.push(`| ${g} | ${v.count} | ${v.quantity} |`);\n\t}\n\tlines.push(\"\", \"## Errori più frequenti\", \"\", \"| Codice | Conteggio |\", \"|---|---|\");\n\tfor (const [c, n] of top) lines.pu